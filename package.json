{
  "name": "breathly-app-expo",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "bash -lc 'source ./scripts/android-env.sh && expo run:android \"$@\"' --",
    "android:prebuild": "bash -lc 'source ./scripts/android-env.sh && expo prebuild --platform android \"$@\"' --",
    "android:start": "bash -lc 'source ./scripts/android-env.sh && expo start --dev-client --android \"$@\"' --",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ignore-path .gitignore .",
    "lint:fix": "yarn lint --fix",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "color": "^4.2.3",
    "expo": "^55.0.17",
    "expo-asset": "~55.0.16",
    "expo-audio": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-dev-client": "~55.0.28",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-keep-awake": "~55.0.6",
    "expo-linear-gradient": "~55.0.13",
    "expo-navigation-bar": "~55.0.12",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "ms": "^3.0.0-canary.1",
    "nativewind": "2.0.11",
    "patch-package": "^8.0.1",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "tailwindcss": "^3.3.2",
    "zustand": "^4.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@types/color": "^3.0.3",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~55.0.18",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "expo-doctor": "^1.18.19",
    "prettier": "^2.8.3",
    "prettier-plugin-tailwindcss": "^0.2.2",
    "typescript": "~5.9.2"
  }
}
